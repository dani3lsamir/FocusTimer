<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Permite compilar el .exe de Windows también desde Linux/macOS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>FocusTimer.App</RootNamespace>
    <AssemblyName>FocusTimer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Memoria baja: GC de estación sin hilo concurrente y sin datos de ICU. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Publicación: un solo .exe que usa el .NET 10 Desktop Runtime instalado. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\icon.png" LogicalName="FocusTimer.icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusTimer.Core\FocusTimer.Core.csproj" />
  </ItemGroup>
</Project>
