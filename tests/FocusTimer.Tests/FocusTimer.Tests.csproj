<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Único paquete NuGet del repo. Solo para tests; nunca se incluyen en el .exe. Sin código de red ni telemetría en tiempo de ejecución. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\FocusTimer.Core\FocusTimer.Core.csproj" />
  </ItemGroup>
</Project>
